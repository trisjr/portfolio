---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { url } from "../lib/path";
import "../styles/pages/projects.css";

const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
);

const entries = await Promise.all(
    projects.map(async (p) => ({ ...p, Content: (await render(p)).Content })),
);

const cats = [
    "All",
    ...Array.from(new Set(projects.map((p) => p.data.category.split(" · ")[0]))),
];
---

<Layout title="Projects — TrisJr" active="projects" description="Selected work by TrisJr — technically complex web platforms across ad-tech, healthcare, gov-tech and AI-native tooling.">
    <main>
        <section class="wrap page-head" data-screen-label="Projects header">
            <p class="kicker reveal">// the work</p>
            <h1 class="h-glow reveal" data-d="1">Projects from <span class="gradient-text">the void</span></h1>
            <p class="reveal" data-d="2">Systems, tools, and experiments I've designed and shipped. Click any node to
                open its dossier.</p>
            <div class="filters reveal" data-d="3" id="filters">
                {cats.map((c, i) => (
                    <button class={"filter" + (i === 0 ? " on" : "")} data-cat={c}>{c}</button>
                ))}
            </div>
        </section>

        <section class="wrap" style="padding-bottom:var(--4xl)">
            <div class="grid" id="grid">
                {entries.map((p, i) => (
                    <article class="card proj reveal" data-d={(i % 4) + 1} data-id={p.id} data-cat={p.data.category}>
                        <div class="proj__top">
                            <span class="proj__num">P / 0{i + 1}</span>
                            <span class="proj__yr">{p.data.year}</span>
                        </div>
                        <div class="proj__viz" style={`background:radial-gradient(70% 90% at 50% 30%,rgba(${p.data.tint},.14),transparent)`}>
                            <span class="ring" style={`border-color:rgba(${p.data.tint},.5)`}></span>
                            <span class="ring" style={`border-color:rgba(${p.data.tint},.7)`}></span>
                            <span class="core" style={`background:rgb(${p.data.tint});box-shadow:0 0 18px rgb(${p.data.tint})`}></span>
                        </div>
                        <div class="proj__body">
                            <span class="proj__cat" style={`color:rgb(${p.data.tint})`}>{p.data.category}</span>
                            <h3>{p.data.title}</h3>
                            <p>{p.data.tagline}</p>
                            <div class="chips">
                                {p.data.stack.slice(0, 4).map((s) => <span class="chip">{s}</span>)}
                            </div>
                        </div>
                    </article>
                ))}
            </div>
        </section>
    </main>

    <!-- modal -->
    <div class="modal" id="modal" role="dialog" aria-modal="true">
        <div class="modal__scrim" data-close></div>
        <div class="card modal__panel" id="modalPanel">
            <button class="modal__close" data-close aria-label="Close">&times;</button>
            <div id="modalContent"></div>
        </div>
    </div>

    <!-- pre-rendered modal bodies, cloned in by id on click -->
    {entries.map((p) => (
        <template data-modal-id={p.id}>
            <div class="modal__hero" style={`background:radial-gradient(80% 120% at 50% 0%,rgba(${p.data.tint},.22),transparent)`}>
                <span class="modal__num" style={`color:rgba(${p.data.tint},.6)`}>{p.data.title[0]}</span>
            </div>
            <div class="modal__in">
                <span class="proj__cat" style={`color:rgb(${p.data.tint})`}>{p.data.category}</span>
                <h2>{p.data.title}</h2>
                <div class="modal__meta">
                    <div><span>Year</span><b>{p.data.year}</b></div>
                    <div><span>Role</span><b>{p.data.role}</b></div>
                    <div><span>Stack</span><b>{p.data.stack.length} tech</b></div>
                </div>
                <p.Content />
                <ul class="modal__hl">
                    {p.data.highlights.map((h) => (
                        <li>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>{h}
                        </li>
                    ))}
                </ul>
                <div class="chips">
                    {p.data.stack.map((s) => <span class="chip chip--on">{s}</span>)}
                </div>
                <div class="modal__actions">
                    <a class="btn btn--primary" href={url(`/projects/${p.id}`)}>View full case study<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                    {p.data.links.live !== "#" && (
                        <a class="btn btn--ghost" href={p.data.links.live} target="_blank" rel="noopener">View live</a>
                    )}
                    {p.data.links.code !== "#" && (
                        <a class="btn btn--ghost" href={p.data.links.code} target="_blank" rel="noopener">Source code</a>
                    )}
                </div>
            </div>
        </template>
    ))}

    <script slot="scripts">
      document.addEventListener("astro:page-load", () => {
        const grid = document.getElementById("grid");
        if (!grid) return;
        const filtersEl = document.getElementById("filters");
        const root = document.documentElement;
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        let active = "All";

        // Same-document view transitions for the filter and the dossier.
        // Never while an Astro page transition is still running (e.g. landing
        // on a /projects#id deep link) — starting one would cut the warp short.
        const canMorph = () =>
          !reduce && "startViewTransition" in document && !root.hasAttribute("data-astro-transition");

        // `kind` scopes the CSS (html.vt-filter / html.vt-dossier). Resolves
        // true when this was still the latest run of its kind — a run cut
        // short by a newer one (rapid clicks) leaves the cleanup to that one.
        const runs = {};
        function transition(kind, update) {
          if (!canMorph()) {
            update();
            return Promise.resolve(true);
          }
          const run = runs[kind] = (runs[kind] || 0) + 1;
          root.classList.add("vt-" + kind);
          return document.startViewTransition(update).finished
            .catch(() => {})
            .then(() => {
              const latest = runs[kind] === run;
              if (latest) root.classList.remove("vt-" + kind);
              return latest;
            });
        }

        const vtName = card => "proj-" + card.dataset.id.replace(/[^a-z0-9-]/gi, "-");

        filtersEl.querySelectorAll(".filter").forEach(b => {
          b.addEventListener("click", () => {
            if (b.dataset.cat === active) return;
            // name every card so survivors glide to their new slots
            const cards = grid.querySelectorAll(".proj");
            cards.forEach(c => c.style.viewTransitionName = vtName(c));
            transition("filter", () => {
              active = b.dataset.cat;
              filtersEl.querySelectorAll(".filter").forEach(f => f.classList.toggle("on", f === b));
              render(true);
            }).then(latest => latest && cards.forEach(c => c.style.viewTransitionName = ""));
          });
        });

        function render(settle) {
          let n = 0;
          grid.querySelectorAll(".proj").forEach(card => {
            const show = active === "All" || card.dataset.cat.startsWith(active);
            card.style.display = show ? "" : "none";
            if (show) {
              // display:none → shown restarts CSS animations; a filter's view
              // transition is the entrance, so don't replay revealUp too
              card.classList.add("in");
              if (settle) card.classList.add("settled");
              n++;
              const num = card.querySelector(".proj__num");
              if (num) num.textContent = "P / 0" + n;
            }
          });
        }

        // modal — grows out of the clicked card and folds back into it
        const modal = document.getElementById("modal");
        const panel = document.getElementById("modalPanel");
        const mc = document.getElementById("modalContent");
        let origin = null; // card the open dossier grew out of

        function openModal(id, card) {
          const tpl = document.querySelector(`template[data-modal-id="${id}"]`);
          if (!tpl) return;
          origin = card && canMorph() ? card : null;
          if (origin) origin.style.viewTransitionName = "dossier";
          transition("dossier", () => {
            if (origin) {
              origin.style.viewTransitionName = "";
              panel.style.viewTransitionName = "dossier";
            }
            mc.innerHTML = "";
            mc.appendChild(tpl.content.cloneNode(true));
            modal.classList.toggle("morph", !!origin);
            modal.classList.add("open");
            document.body.style.overflow = "hidden";
            history.replaceState(null, "", "#" + id);
          }).then(latest => {
            if (latest) panel.style.viewTransitionName = "";
          });
        }

        function closeModal() {
          if (!modal.classList.contains("open")) return;
          const back = origin && canMorph() ? origin : null;
          origin = null;
          if (back) panel.style.viewTransitionName = "dossier";
          transition("dossier", () => {
            panel.style.viewTransitionName = "";
            if (back) back.style.viewTransitionName = "dossier";
            modal.classList.remove("open", "morph");
            document.body.style.overflow = "";
            history.replaceState(null, "", location.pathname);
          }).then(latest => {
            if (latest && back) back.style.viewTransitionName = "";
          });
        }

        grid.querySelectorAll(".proj").forEach(card =>
          card.addEventListener("click", () => openModal(card.dataset.id, card)));
        modal.querySelectorAll("[data-close]").forEach(el => el.addEventListener("click", closeModal));
        const ac = new AbortController();
        document.addEventListener("keydown", e => {
          if (e.key === "Escape") closeModal();
        }, { signal: ac.signal });
        document.addEventListener("astro:before-swap", () => { ac.abort(); document.body.style.overflow = ""; }, { once: true });

        render();
        // deep link
        if (location.hash) {
          const id = location.hash.slice(1);
          if (document.querySelector(`template[data-modal-id="${id}"]`)) openModal(id);
        }
      });
    </script>
</Layout>
